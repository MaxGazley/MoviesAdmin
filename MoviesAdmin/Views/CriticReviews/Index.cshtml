@model IEnumerable<MoviesAdmin.Models.CriticReview>

@{
    ViewData["Title"] = "Critic Reviews";
}

<h1>Critic Reviews</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Critic Review</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Movie</th>
            <th>Review</th>
            <th>Rating</th>
            <th>Published</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Movie.Title)</td>
                <td>@Html.DisplayFor(modelItem => item.Review)</td>
                <td>@Html.DisplayFor(modelItem => item.Rating)%</td>
                <td>@Html.DisplayFor(modelItem => item.IsPublished)</td>
                <td>@Html.DisplayFor(modelItem => item.CreatedDate)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-secondary">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
