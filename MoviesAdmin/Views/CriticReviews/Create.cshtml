@model MoviesAdmin.Models.CriticReview

@{
    ViewData["Title"] = "Create Critic Review";
    var movies = ViewData["Movies"] as List<MoviesAdmin.Models.Movie> ?? new List<MoviesAdmin.Models.Movie>();
    var selectedMovieTitle = movies.FirstOrDefault(movie => movie.Id == Model.MovieId)?.Title ?? "Select a movie";

}

<h1>Create Critic Review</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label class="form-label" for="movieDropdown">Movie</label>
                <input asp-for="MovieId" type="hidden" />

                <div class="dropdown">
                    <button id="movieDropdown"
                            class="btn btn-outline-secondary dropdown-toggle w-100 text-start"
                            type="button"
                            data-bs-toggle="dropdown"
                            data-bs-auto-close="outside"
                            aria-expanded="false">
                        <span id="selectedMovieText">@selectedMovieTitle</span>
                    </button>

                    <div class="dropdown-menu w-100 p-2" aria-labelledby="movieDropdown">
                        <input id="movieSearch"
                               class="form-control mb-2"
                               type="search"
                               placeholder="Search movies…"
                               autocomplete="off"
                               aria-label="Search movies" />

                        <div id="movieOptions">
                            @foreach (var movie in movies)
                            {
                                <button class="dropdown-item movie-option"
                                        type="button"
                                        data-movie-id="@movie.Id">
                                    @movie.Title
                                </button>
                            }
                        </div>

                        <div id="movieNoResults" class="text-muted px-2 d-none">
                            No results found
                        </div>
                    </div>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Review" class="form-label"></label>
                <textarea asp-for="Review" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Review" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Rating" class="form-label"></label>
                <input asp-for="Rating" class="form-control" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="IsPublished" class="form-check-input" />
                <label asp-for="IsPublished" class="form-check-label"></label>
                <span asp-validation-for="IsPublished" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById("movieSearch");
        const movieOptions = [...document.querySelectorAll(".movie-option")];
        const noResults = document.getElementById("movieNoResults");
        const movieIdInput = document.getElementById("MovieId");
        const selectedMovieText = document.getElementById("selectedMovieText");
        const dropdownButton = document.getElementById("movieDropdown");

        function filterMovies() {
            const query = searchInput.value.trim().toLowerCase();
            let visibleCount = 0;

            movieOptions.forEach(option => {
                const matches = option.textContent.trim().toLowerCase().includes(query);
                option.hidden = !matches;
                if (matches) visibleCount++;
            });

            noResults.classList.toggle("d-none", visibleCount > 0);
        }

        searchInput.addEventListener("input", filterMovies);

        movieOptions.forEach(option => {
            option.addEventListener("click", () => {
                movieIdInput.value = option.dataset.movieId;
                selectedMovieText.textContent = option.textContent.trim();

                searchInput.value = "";
                filterMovies();

                bootstrap.Dropdown.getOrCreateInstance(dropdownButton).hide();
            });
        });
    </script>
}