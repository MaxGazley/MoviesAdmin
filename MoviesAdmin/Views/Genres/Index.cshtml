@model IEnumerable<MoviesAdmin.Models.Genre>

@{
	ViewData["Title"] = "Genres";
}

<h1>Genres</h1>

<p>
	<a asp-action="Create" class="btn btn-primary">Create New Genre</a>
</p>

<table class="table">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.First().Title)
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.Title)
				</td>
				<td>
					<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary">Edit</a>
					<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary">Details</a>
					<a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-secondary">Delete</a>
				</td>
			</tr>
		}
	</tbody>
</table>
